// ─────────────────────────────────────────────────────────────────────────────
// Integral Academy — Executive Workspace
// Normalised relational schema (PostgreSQL).
//
// Conventions
// • Money is stored as DECIMAL(14,2) in South African Rand (ZAR).
// • Calendar dates (no time component) use @db.Date.
// • Demo/seed rows use ids prefixed with "demo_" (see prisma/seed/remove-demo.ts).
// • Learner / Subscription / Payment / EngagementSnapshot are a read-model of the
//   learner-facing platform; they are written by the integration layer
//   (src/server/integrations/learner-platform), never by executives.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

