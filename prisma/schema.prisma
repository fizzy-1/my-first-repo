// ═══════════════════════ Identity, access & organisation ═════════════════════

model Department {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users      User[]
  tasks      Task[]
  projects   Project[]
  expenses   Expense[]
  budgets    Budget[]
  objectives Objective[]
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  /// System roles are defined in code (src/server/rbac/roles.ts) and re-synced by the seed.
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  passwordHash      String
  jobTitle          String?
  phone             String?
  status            UserStatus     @default(ACTIVE)
  employmentType    EmploymentType @default(EMPLOYEE)
  startDate         DateTime?      @db.Date
  /// Sensitive: monthly cost to company. Only visible with team.read.sensitive.
  monthlyCost       Decimal?       @db.Decimal(12, 2)
  roleId            String
  departmentId      String?
  managerId         String?
  lastLoginAt       DateTime?
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    User?       @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports    User[]      @relation("ManagerReports")

  sessions            Session[]
  dashboardPreference DashboardPreference?
  notifications       Notification[]
  announcements       Announcement[]
  tasksAssigned       Task[]                @relation("TaskAssignee")
  tasksCreated        Task[]                @relation("TaskCreator")
  projectsOwned       Project[]
  approvalsRequested  Approval[]            @relation("ApprovalRequester")
  approvalsAssigned   Approval[]            @relation("ApprovalApprover")
  approvalDecisions   ApprovalDecision[]
  incomeCreated       Income[]
  expensesSubmitted   Expense[]
  budgetsCreated      Budget[]
  projectionsCreated  FinancialProjection[]
  schoolsOwned        School[]
  schoolNotes         SchoolNote[]
  campaignsOwned      Campaign[]
  campaignMemberships CampaignMember[]
  coursesLed          Course[]
  contentAssigned     ContentItem[]         @relation("ContentAssignee")
  contentReviewing    ContentItem[]         @relation("ContentReviewer")
  tutorProfile        TutorProfile?
  timeEntriesApproved TutorTimeEntry[]
  featuresOwned       Feature[]
  bugsReported        Bug[]                 @relation("BugReporter")
  bugsAssigned        Bug[]                 @relation("BugAssignee")
  documentsOwned      Document[]
  documentVersions    DocumentVersion[]
  documentGrants      DocumentAccessGrant[]
  meetingsOrganised   Meeting[]
  meetingAttendance   MeetingAttendee[]
  meetingDecisions    MeetingDecision[]
  objectivesOwned     Objective[]
  objectiveUpdates    ObjectiveUpdate[]
  auditLogs           AuditLog[]

  @@index([roleId])
  @@index([departmentId])
  @@index([status])
}

model Session {
  /// SHA-256 (hex) of the opaque session token held in the browser cookie.
  /// The raw token is never stored.
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Every sign-in attempt; drives IP/email rate limiting across instances.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([email, createdAt])
}

/// Per-user dashboard customisation (widget order / visibility / default range).
model DashboardPreference {
  userId        String   @id
  hiddenWidgets String[] @default([])
  widgetOrder   String[] @default([])
  defaultRange  String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════ Work management ═════════════════════════════════════

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  ownerId      String?
  departmentId String?
  startDate    DateTime?     @db.Date
  dueDate      DateTime?     @db.Date
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks      Task[]

  @@index([status])
}

/// The single task system. Meeting action items (meetingId) and development
/// tasks (featureId / bugId) are tasks too, so they appear in "My tasks".
model Task {
  id           String     @id @default(cuid())
  number       Int        @unique @default(autoincrement())
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  completedAt  DateTime?
  assigneeId   String?
  creatorId    String
  departmentId String?
  projectId    String?
  meetingId    String?
  featureId    String?
  bugId        String?
  schoolId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id])
  department  Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting     Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  feature     Feature?         @relation(fields: [featureId], references: [id], onDelete: SetNull)
  bug         Bug?             @relation(fields: [bugId], references: [id], onDelete: SetNull)
  school      School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@index([assigneeId, status])
  @@index([departmentId, status])
  @@index([status, dueDate])
  @@index([creatorId])
  @@index([projectId])
  @@index([meetingId])
  @@index([featureId])
  @@index([schoolId])
}

model TaskAttachment {
  taskId     String
  documentId String
  createdAt  DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([taskId, documentId])
  @@index([documentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  /// Idempotency key for system-generated notifications (e.g. "task-overdue:<id>").
  dedupeKey String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model Announcement {
  id          String            @id @default(cuid())
  title       String
  body        String
  level       AnnouncementLevel @default(INFO)
  authorId    String
  publishedAt DateTime          @default(now())
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@index([publishedAt])
}

// ═══════════════════════ Approvals ═══════════════════════════════════════════

model Approval {
  id          String         @id @default(cuid())
  number      Int            @unique @default(autoincrement())
  type        ApprovalType
  title       String
  description String
  amount      Decimal?       @db.Decimal(14, 2)
  status      ApprovalStatus @default(PENDING)
  priority    Priority       @default(MEDIUM)
  dueDate     DateTime?      @db.Date
  requesterId String
  /// Optional named approver; otherwise any user with decision rights may decide.
  approverId  String?
  expenseId   String?        @unique
  campaignId  String?
  featureId   String?
  documentId  String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  requester User               @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approver  User?              @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)
  expense   Expense?           @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  campaign  Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  feature   Feature?           @relation(fields: [featureId], references: [id], onDelete: SetNull)
  document  Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  decisions ApprovalDecision[]

  @@index([status, type])
  @@index([requesterId])
  @@index([approverId, status])
  @@index([createdAt])
}

model ApprovalDecision {
  id         String               @id @default(cuid())
  approvalId String
  deciderId  String
  decision   ApprovalDecisionType
  comment    String?
  createdAt  DateTime             @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  decider  User     @relation(fields: [deciderId], references: [id])

  @@index([approvalId, createdAt])
}

// ═══════════════════════ Learner platform read-model ═════════════════════════
// Data minimisation (POPIA): no learner names, emails or contact details are
// mirrored into the executive workspace — only what aggregate metrics need.

model SubscriptionPlan {
  id                String          @id @default(cuid())
  code              String          @unique
  name              String
  interval          BillingInterval
  price             Decimal         @db.Decimal(10, 2)
  /// Price normalised to one month (annual price / 12).
  monthlyEquivalent Decimal         @db.Decimal(10, 2)
  isActive          Boolean         @default(true)

  subscriptions Subscription[]
}

model Learner {
  id           String        @id @default(cuid())
  /// Learner id on the learner-facing platform.
  externalId   String?       @unique
  grade        Int
  province     Province?
  schoolId     String?
  signedUpAt   DateTime
  lastActiveAt DateTime?
  status       LearnerStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school        School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  payments      Payment[]

  @@index([signedUpAt])
  @@index([schoolId])
  @@index([lastActiveAt])
}

model Subscription {
  id               String             @id @default(cuid())
  externalId       String?            @unique
  learnerId        String
  planId           String
  status           SubscriptionStatus
  source           SubscriptionSource @default(DIRECT)
  schoolId         String?
  startedAt        DateTime
  cancelledAt      DateTime?
  currentPeriodEnd DateTime?
  /// Monthly recurring revenue contributed (0 for school-sponsored seats).
  mrr              Decimal            @db.Decimal(10, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  learner  Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  school   School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([status])
  @@index([startedAt])
  @@index([cancelledAt])
  @@index([learnerId])
  @@index([schoolId])
}

model Payment {
  id             String        @id @default(cuid())
  externalId     String?       @unique
  learnerId      String
  subscriptionId String?
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus
  method         PaymentMethod
  reference      String?
  paidAt         DateTime
  createdAt      DateTime      @default(now())

  learner      Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([paidAt, status])
  @@index([subscriptionId])
}

/// Weekly per-course engagement aggregates from the learner platform.
model EngagementSnapshot {
  id               String   @id @default(cuid())
  courseId         String
  weekStart        DateTime @db.Date
  activeLearners   Int
  lessonsCompleted Int
  videoMinutes     Int
  quizAttempts     Int
  avgQuizScore     Decimal  @db.Decimal(5, 2)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, weekStart])
  @@index([weekStart])
}

// ═══════════════════════ Finance ═════════════════════════════════════════════

/// Bank / cash accounts. Cash position = Σ opening balances + cash in − cash out
/// since the opening dates.
model CashAccount {
  id             String   @id @default(cuid())
  name           String
  institution    String
  openingBalance Decimal  @db.Decimal(14, 2)
  openingDate    DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

/// Manually recorded income (school contracts, workshops, grants…).
/// Learner subscription payments are synced into Payment instead.
model Income {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  date          DateTime       @db.Date
  customer      String
  schoolId      String?
  description   String
  category      IncomeCategory
  amount        Decimal        @db.Decimal(14, 2)
  paymentMethod PaymentMethod?
  reference     String?
  status        IncomeStatus   @default(INVOICED)
  dueDate       DateTime?      @db.Date
  receivedAt    DateTime?      @db.Date
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school    School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status])
  @@index([category, date])
  @@index([schoolId])
}

model Expense {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement())
  date          DateTime        @db.Date
  supplier      String
  description   String
  category      ExpenseCategory
  departmentId  String?
  amount        Decimal         @db.Decimal(14, 2)
  status        ExpenseStatus   @default(PENDING_APPROVAL)
  dueDate       DateTime?       @db.Date
  paidAt        DateTime?       @db.Date
  paymentMethod PaymentMethod?
  reference     String?
  /// Supporting document (invoice / receipt) in the document repository.
  documentId    String?
  submittedById String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  submittedBy User        @relation(fields: [submittedById], references: [id])
  approval    Approval?

  @@index([date])
  @@index([status])
  @@index([category, date])
  @@index([departmentId, date])
}

model Budget {
  id           String     @id @default(cuid())
  name         String
  type         BudgetType
  fiscalYear   Int
  /// Null = company-wide budget.
  departmentId String?
  notes        String?
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User         @relation(fields: [createdById], references: [id])
  lines      BudgetLine[]

  @@index([fiscalYear])
}

model BudgetLine {
  id       String          @id @default(cuid())
  budgetId String
  category ExpenseCategory
  amount   Decimal         @db.Decimal(14, 2)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
}

/// Driver-based financial model; outputs are computed (src/lib/projections.ts).
model FinancialProjection {
  id                      String       @id @default(cuid())
  name                    String
  scenario                ScenarioType
  startMonth              DateTime     @db.Date
  horizonMonths           Int          @default(12)
  startingLearners        Int
  monthlyNewLearners      Int
  newLearnerGrowthRate    Decimal      @db.Decimal(6, 4)
  monthlyChurnRate        Decimal      @db.Decimal(6, 4)
  avgSubscriptionPrice    Decimal      @db.Decimal(10, 2)
  schoolRevenueMonthly    Decimal      @db.Decimal(14, 2)
  schoolRevenueGrowthRate Decimal      @db.Decimal(6, 4)
  salariesMonthly         Decimal      @db.Decimal(14, 2)
  salaryGrowthRate        Decimal      @db.Decimal(6, 4)
  marketingMonthly        Decimal      @db.Decimal(14, 2)
  technologyMonthly       Decimal      @db.Decimal(14, 2)
  otherExpensesMonthly    Decimal      @db.Decimal(14, 2)
  startingCash            Decimal      @db.Decimal(14, 2)
  notes                   String?
  createdById             String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])
}

// ═══════════════════════ Schools & partnerships (CRM) ════════════════════════

model School {
  id                  String      @id @default(cuid())
  name                String
  /// Department of Basic Education EMIS number.
  emisNumber          String?     @unique
  type                SchoolType  @default(PUBLIC)
  province            Province
  city                String
  address             String?
  phone               String?
  email               String?
  website             String?
  learnerCount        Int         @default(0)
  potentialLearners   Int         @default(0)
  stage               SchoolStage @default(PROSPECT)
  stageChangedAt      DateTime    @default(now())
  expectedAnnualValue Decimal     @default(0) @db.Decimal(14, 2)
  /// Win probability (0–100) used for weighted pipeline value.
  probability         Int         @default(10)
  ownerId             String?
  nextFollowUpAt      DateTime?
  lostReason          String?
  source              String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner         User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts      SchoolContact[]
  notes         SchoolNote[]
  partnerships  Partnership[]
  meetings      Meeting[]
  documents     Document[]
  learners      Learner[]
  subscriptions Subscription[]
  income        Income[]
  tasks         Task[]

  @@index([stage])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@index([province])
}

model SchoolContact {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  position  String
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SchoolNote {
  id        String   @id @default(cuid())
  schoolId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([schoolId, createdAt])
}

model Partnership {
  id                 String            @id @default(cuid())
  schoolId           String
  status             PartnershipStatus @default(DRAFT)
  startDate          DateTime          @db.Date
  endDate            DateTime?         @db.Date
  annualValue        Decimal           @db.Decimal(14, 2)
  learnersCovered    Int
  billingFrequency   BillingFrequency  @default(QUARTERLY)
  contractDocumentId String?
  signedAt           DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  contractDocument Document? @relation(fields: [contractDocumentId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([status])
  @@index([endDate])
}

// ═══════════════════════ Marketing ═══════════════════════════════════════════

model Campaign {
  id             String          @id @default(cuid())
  name           String
  description    String?
  objective      String?
  targetAudience String?
  channel        CampaignChannel
  status         CampaignStatus  @default(DRAFT)
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  budget         Decimal         @db.Decimal(14, 2)
  ownerId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  owner     User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members   CampaignMember[]
  metrics   CampaignMetric[]
  approvals Approval[]

  @@index([status])
  @@index([startDate])
}

model CampaignMember {
  campaignId String
  userId     String
  addedAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId])
}

/// Periodic (weekly) performance figures per campaign.
model CampaignMetric {
  id          String   @id @default(cuid())
  campaignId  String
  periodStart DateTime @db.Date
  spend       Decimal  @db.Decimal(12, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, periodStart])
  @@index([periodStart])
}

// ═══════════════════════ Academic operations ═════════════════════════════════

model Course {
  id          String       @id @default(cuid())
  title       String
  subject     String
  grade       Int
  description String?
  status      CourseStatus @default(ACTIVE)
  leadTutorId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  leadTutor    User?                @relation(fields: [leadTutorId], references: [id], onDelete: SetNull)
  topics       Topic[]
  contentItems ContentItem[]
  engagement   EngagementSnapshot[]
}

model Topic {
  id        String @id @default(cuid())
  courseId  String
  title     String
  /// CAPS term in which the topic is taught (1–4).
  capsTerm  Int?
  sortOrder Int    @default(0)

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  contentItems ContentItem[]

  @@unique([courseId, title])
}

model Lesson {
  id              String       @id @default(cuid())
  topicId         String
  title           String
  sortOrder       Int          @default(0)
  status          LessonStatus @default(DRAFT)
  durationMinutes Int?
  publishedAt     DateTime?

  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]

  @@index([topicId])
}

/// A unit of content moving through the production pipeline.
model ContentItem {
  id             String       @id @default(cuid())
  title          String
  type           ContentType
  stage          ContentStage @default(IDEA)
  priority       Priority     @default(MEDIUM)
  courseId       String?
  topicId        String?
  lessonId       String?
  assigneeId     String?
  reviewerId     String?
  dueDate        DateTime?    @db.Date
  publishedAt    DateTime?
  estimatedHours Decimal?     @db.Decimal(6, 2)
  notes          String?
  stageChangedAt DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  topic       Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  lesson      Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assignee    User?            @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer    User?            @relation("ContentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  timeEntries TutorTimeEntry[]

  @@index([stage])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([courseId])
}

model TutorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  specialisation      String
  hourlyRate          Decimal? @db.Decimal(10, 2)
  weeklyCapacityHours Int      @default(20)
  bio                 String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TutorTimeEntry[]
}

model TutorTimeEntry {
  id            String          @id @default(cuid())
  tutorId       String
  date          DateTime        @db.Date
  hours         Decimal         @db.Decimal(5, 2)
  activity      TutorActivity
  contentItemId String?
  description   String?
  status        TimeEntryStatus @default(SUBMITTED)
  approvedById  String?
  createdAt     DateTime        @default(now())

  tutor       TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  approvedBy  User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tutorId, date])
  @@index([status])
}

// ═══════════════════════ Product & technology ════════════════════════════════

model Feature {
  id          String        @id @default(cuid())
  title       String
  description String?
  priority    Priority      @default(MEDIUM)
  status      FeatureStatus @default(BACKLOG)
  ownerId     String?
  targetDate  DateTime?     @db.Date
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  bugs      Bug[]
  tasks     Task[]
  approvals Approval[]

  @@index([status])
}

model Bug {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement())
  title       String
  description String?
  severity    BugSeverity
  status      BugStatus   @default(OPEN)
  environment String?
  reporterId  String
  assigneeId  String?
  featureId   String?
  reportedAt  DateTime    @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  reporter User     @relation("BugReporter", fields: [reporterId], references: [id])
  assignee User?    @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  feature  Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  tasks    Task[]

  @@index([status, severity])
  @@index([assigneeId])
  @@index([reporterId])
}

// ═══════════════════════ Documents ═══════════════════════════════════════════

model DocumentFolder {
  id        String           @id @default(cuid())
  category  DocumentCategory
  name      String
  createdAt DateTime         @default(now())

  documents Document[]

  @@unique([category, name])
}

model Document {
  id             String              @id @default(cuid())
  title          String
  description    String?
  category       DocumentCategory
  folderId       String?
  ownerId        String
  accessLevel    DocumentAccessLevel @default(DEPARTMENT)
  schoolId       String?
  /// Latest version number (denormalised for listing).
  currentVersion Int                 @default(1)
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  folder          DocumentFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  owner           User                  @relation(fields: [ownerId], references: [id])
  school          School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  versions        DocumentVersion[]
  tags            DocumentTag[]
  accessGrants    DocumentAccessGrant[]
  taskAttachments TaskAttachment[]
  expenses        Expense[]
  approvals       Approval[]
  partnerships    Partnership[]

  @@index([category, folderId])
  @@index([ownerId])
  @@index([schoolId])
  @@index([updatedAt])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  fileName     String
  mimeType     String
  sizeBytes    Int
  /// Opaque key in the storage adapter (never a user-supplied path).
  storageKey   String   @unique
  /// SHA-256 of the file contents.
  checksum     String
  changeNote   String?
  uploadedById String
  createdAt    DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  documents DocumentTag[]
}

model DocumentTag {
  documentId String
  tagId      String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
}

/// Explicit per-user access to RESTRICTED documents.
model DocumentAccessGrant {
  documentId String
  userId     String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

// ═══════════════════════ Meetings ════════════════════════════════════════════

model Meeting {
  id          String        @id @default(cuid())
  title       String
  type        MeetingType
  status      MeetingStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  videoLink   String?
  agenda      String?
  notes       String?
  organizerId String
  schoolId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer   User              @relation(fields: [organizerId], references: [id])
  school      School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  attendees   MeetingAttendee[]
  decisions   MeetingDecision[]
  actionItems Task[]

  @@index([startsAt])
  @@index([organizerId])
  @@index([type, startsAt])
}

model MeetingAttendee {
  meetingId String
  userId    String
  response  AttendeeResponse @default(PENDING)
  attended  Boolean?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
}

model MeetingDecision {
  id           String   @id @default(cuid())
  meetingId    String
  description  String
  recordedById String
  createdAt    DateTime @default(now())

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([meetingId])
}

// ═══════════════════════ Strategy ════════════════════════════════════════════

model Objective {
  id           String          @id @default(cuid())
  title        String
  description  String?
  ownerId      String
  departmentId String?
  /// Quarterly objectives roll up to an annual company objective.
  parentId     String?
  year         Int
  /// Null for annual objectives.
  quarter      Int?
  metric       ObjectiveMetric @default(MANUAL)
  unit         String          @default("")
  startValue   Decimal         @default(0) @db.Decimal(14, 2)
  targetValue  Decimal         @db.Decimal(14, 2)
  currentValue Decimal         @default(0) @db.Decimal(14, 2)
  deadline     DateTime        @db.Date
  status       ObjectiveStatus @default(ON_TRACK)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  owner      User              @relation(fields: [ownerId], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parent     Objective?        @relation("ObjectiveHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Objective[]       @relation("ObjectiveHierarchy")
  updates    ObjectiveUpdate[]

  @@index([year, quarter])
  @@index([ownerId])
}

model ObjectiveUpdate {
  id          String          @id @default(cuid())
  objectiveId String
  value       Decimal         @db.Decimal(14, 2)
  status      ObjectiveStatus
  note        String?
  authorId    String
  createdAt   DateTime        @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([objectiveId, createdAt])
}

// ═══════════════════════ Audit ═══════════════════════════════════════════════

/// Append-only record of every important administrative action.
/// Entries flagged `feed` also drive the dashboard's Recent Activity.
model AuditLog {
  id         String   @id @default(cuid())
  /// Null for system actions (e.g. learner-platform sync).
  actorId    String?
  action     String
  module     String
  entityType String
  entityId   String?
  summary    String
  before     Json?
  after      Json?
  ipAddress  String?
  feed       Boolean  @default(false)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
  @@index([feed, createdAt])
}
