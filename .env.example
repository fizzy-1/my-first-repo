# ─────────────────────────────────────────────────────────────
# Integral Academy — Executive Workspace environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://integral:integral@localhost:5432/integral_workspace?schema=public"

# Public base URL of the workspace (used for absolute links in notifications/exports).
APP_URL="http://localhost:3000"

# Session lifetime in days (sliding expiry; sessions are stored in the database and revocable).
SESSION_TTL_DAYS="7"

# Where uploaded documents are stored by the local storage adapter.
# Must be outside /public. Swap the adapter in src/server/storage for S3 etc.
STORAGE_DIR="./storage/uploads"

# Bearer token required by POST /api/cron/deadlines — the idempotent deadline sweep
# (overdue / due-soon tasks, school follow-ups, stale approvals, partnership renewals,
# overdue invoices). Call it hourly or daily from any scheduler:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" "$APP_URL/api/cron/deadlines"
# The endpoint answers 503 while this is empty. `npm run jobs:deadlines` runs the same job
# from a shell without it. Generate with: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-string"

# Bearer token the learner platform (or its ETL job) sends to
# POST /api/integrations/learner-platform/sync to push learners, subscriptions, payments
# and engagement (payload schema: src/server/integrations/learner-platform/sync.ts).
# The endpoint answers 503 while this is empty. Generate with: openssl rand -hex 32
LEARNER_PLATFORM_SYNC_TOKEN=""

# Password given to every seeded demo user (development only).
SEED_DEMO_PASSWORD="Integral!2026"

# Number of trusted reverse proxies in front of the app (load balancer, CDN…).
# Used to read the real client IP from X-Forwarded-For for sign-in rate limiting.
TRUSTED_PROXY_HOPS="1"

# Show the "Demo data" banner in the top bar.
DEMO_MODE="true"
